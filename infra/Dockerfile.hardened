# Étape 1 : Build de l'application T2C-Phantom
FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY . .

# Compilation statique sans dépendances externes (CGO_ENABLED=0)
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o t2c-phantom ./cmd/t2c/main.go

# Étape 2 : Création de la cellule Distroless (Vide)
FROM gcr.io/distroless/static-debian12:nonroot

# 🛡️ SECURITE : L'image Distroless ne contient AUCUN shell (/bin/sh, /bin/bash n'existent pas)
# Pas de curl, pas de wget, pas de python. 
# Si un attaquant exploite une faille (RCE), il se retrouve enfermé dans une coquille vide.

WORKDIR /app

# Copie du binaire compilé depuis l'étape 1
COPY --from=builder /app/t2c-phantom /app/t2c-phantom

# 🛡️ SECURITE : Abandon total des privilèges. Exécution sous l'utilisateur "nonroot" (nobody)
# uid=65532(nonroot) gid=65532(nonroot)
USER 65532:65532

# Déclaration du port
EXPOSE 443

# Exécution directe du binaire (SANS shell, ce qui empêche les injections)
ENTRYPOINT ["/app/t2c-phantom"]

# 🛡️ SECURITE : Verrouillage du FS en lecture seule (Read-Only)
# NOTE POUR L'ADMINISTRATEUR (SysAdmin) :
# Lors de l'exécution du conteneur Docker, vous DEVEZ utiliser les flags suivants pour sécuriser le stockage :
# 
# docker run -d --name t2c-phantom \
#   --read-only \
#   --tmpfs /tmp/t2c_cache:rw,noexec,nosuid,nodev \
#   --cap-drop=ALL \
#   --security-opt="no-new-privileges:true" \
#   -p 443:443 \
#   t2c-phantom-hardened
#
# Explication des flags :
# --read-only : Interdit l'écriture sur le disque.
# --tmpfs /tmp/t2c_cache:rw,noexec : Autorise l'écriture uniquement dans le cache, mais INTERDIT d'y exécuter un virus.
# --cap-drop=ALL : Retire absolument toutes les permissions (Capabilities) Linux au conteneur.
